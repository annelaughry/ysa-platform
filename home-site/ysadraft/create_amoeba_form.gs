/**
 * CREATE PROJECT AMOEBA SUBMISSION FORM
 * ──────────────────────────────────────
 * HOW TO USE:
 *   1. Go to script.google.com → New project
 *   2. Paste this entire file, replacing any existing code
 *   3. Click Run → createAmoebaForm
 *   4. Authorize when prompted (Google needs permission to create Forms)
 *   5. The form URL will appear in the Execution log (View → Logs)
 *   6. Copy the published form URL and paste into amoeba.html
 *
 * After creating: Forms → Responses → Link to Sheets (green icon)
 * to auto-collect submissions into a Google Sheet.
 */

function createAmoebaForm() {

  // Create the form
  var form = FormApp.create('Project Amoeba — Design Competition Submission');
  form.setDescription(
    'Submit your original YSA mascot design for Project Amoeba. ' +
    'Read the full rules at youngscientistacademy.org before submitting. ' +
    'All designs must be your own original work — no AI generation permitted.'
  );
  form.setCollectEmail(false);        // We ask for email manually so it's visible in the sheet
  form.setAllowResponseEdits(false);
  form.setLimitOneResponsePerUser(false);
  form.setConfirmationMessage(
    'Thank you for submitting to Project Amoeba! 🎨 ' +
    'We\'ll review all entries and announce results. Keep creating!'
  );

  // ── SECTION 1: About You ──────────────────────────────────────────────

  form.addSectionHeaderItem()
    .setTitle('About You')
    .setHelpText('Tell us who you are so we can credit your work.');

  form.addTextItem()
    .setTitle('Full Name')
    .setRequired(true);

  form.addTextItem()
    .setTitle('Email Address')
    .setHelpText('We\'ll use this to contact you if you\'re selected.')
    .setRequired(true);

  form.addTextItem()
    .setTitle('Age / Grade')
    .setHelpText('Optional — helps us recognize submissions from different age groups.')
    .setRequired(false);

  form.addMultipleChoiceItem()
    .setTitle('Are you a current YSA member?')
    .setChoiceValues([
      'Yes — Global STEM Ambassador',
      'Yes — STEM Explorer',
      'No, but I\'m interested in joining',
      'No — submitting as a community member'
    ])
    .setRequired(true);

  form.addTextItem()
    .setTitle('If you\'re a YSA member, which team are you on?')
    .setHelpText('Leave blank if not applicable.')
    .setRequired(false);

  // ── SECTION 2: Your Design ────────────────────────────────────────────

  form.addSectionHeaderItem()
    .setTitle('Your Design')
    .setHelpText('This is the main event. Be specific — judges want to understand your thought process, not just see the final result.');

  form.addTextItem()
    .setTitle('Design Title')
    .setHelpText('Give your mascot a name or short title.')
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('Design Description')
    .setHelpText(
      'Describe your design in at least 3 sentences. ' +
      'What does it represent? How does it capture the amoeba concept ' +
      '(adaptable, always growing, community-first)? ' +
      'What makes it unmistakably YSA?'
    )
    .setRequired(true);

  // File upload — requires the form to be associated with a Google Drive folder
  // Google Forms file uploads go directly to the form owner's Drive.
  form.addFileUploadItem()
    .setTitle('Upload Your Design')
    .setHelpText(
      'Upload your design as a PNG, JPG, SVG, or PDF. ' +
      'Make sure it\'s a clean, high-quality version. Max 10MB.'
    )
    .setAllowedFileTypes([
      FormApp.FileType.IMAGE,  // PNG, JPG, GIF, etc.
      FormApp.FileType.PDF
    ])
    .setMaxFileSize(FormApp.FileSizeLimit.TEN_MEGABYTES)
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('Process Notes')
    .setHelpText(
      'How did you make it? What tools did you use? How long did it take? ' +
      'Optional, but judges love knowing the story behind the work.'
    )
    .setRequired(false);

  // ── SECTION 3: Confirmations ──────────────────────────────────────────

  form.addSectionHeaderItem()
    .setTitle('Before You Submit')
    .setHelpText('Please confirm both items below. Submissions that don\'t meet these requirements will be disqualified.');

  var confirmItem = form.addCheckboxItem();
  confirmItem.setTitle('Confirm the following (both required)')
    .setChoices([
      confirmItem.createChoice('This design is my own original work and was NOT generated by AI tools.'),
      confirmItem.createChoice('This design is scalable — it works at any size, from a phone screen to a banner.')
    ])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('How did you hear about Project Amoeba?')
    .setChoiceValues([
      'YSA website',
      'Social media',
      'A friend or fellow ambassador',
      'YSA summit or event',
      'Email from YSA',
      'Other'
    ])
    .setRequired(false);

  // ── DONE ──────────────────────────────────────────────────────────────

  var url = form.getPublishedUrl();
  var editUrl = form.getEditUrl();

  Logger.log('✅ Form created!');
  Logger.log('Share URL (for embed + sharing): ' + url);
  Logger.log('Edit URL (your admin link):      ' + editUrl);
  Logger.log('');
  Logger.log('Next steps:');
  Logger.log('1. Open the Edit URL to preview and adjust styling.');
  Logger.log('2. Go to Responses → click the green Sheets icon → Create spreadsheet.');
  Logger.log('3. Copy the published URL and paste into amoeba.html as the iframe src.');
}
